# ===== Đăng nhập Google (OAuth) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chuỗi ngẫu nhiên dài, dùng ký cookie tạm khi đăng nhập
SESSION_SECRET=
# Email Admin đầu tiên (tự thêm vào tab Users khi tab còn trống)
BOOTSTRAP_ADMIN_EMAIL=

# ===== Google Sheets =====
# Nội dung JSON của key service account, hoặc đường dẫn tới file key
GOOGLE_SERVICE_ACCOUNT_JSON=
SYSTEM_SPREADSHEET_ID=

# ===== GitHub App (xem README, mục 4) =====
GITHUB_APP_ID=
# Nội dung file .pem viết trên MỘT dòng, xuống dòng thay bằng 
, đặt trong dấu nháy đơn
GITHUB_APP_PRIVATE_KEY=

# ===== AI (chưa dùng ở M4; để sau khi AI điền sẵn bước tự động) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ===== Chạy test bằng Playwright (M4) =====
MAX_CASES_PER_RUN=200
# Thời gian tối đa cho một case (giây) và cho một bước (mili giây)
CASE_TIMEOUT_SECONDS=120
STEP_TIMEOUT_MS=10000
# Thời gian chờ app của dự án bật lên (giây)
APP_START_TIMEOUT_SECONDS=120

# ===== Hạ tầng =====
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
